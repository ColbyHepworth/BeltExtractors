<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BeltExtractors</AssemblyName>
    <RootNamespace>BeltExtractors</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>../1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <!-- The repo cloned into RimWorld/Mods; mods/Directory.Build.props sets it in Colby's workspace. -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProjectDirectory)\..\..\..</GameDir>
    <!-- Vanilla Expanded Framework and VFE Factory, from the Steam library's Workshop folder. -->
    <WorkshopDir Condition="'$(WorkshopDir)' == ''">$(GameDir)\..\..\workshop\content\294100</WorkshopDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(GameDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PipeSystem">
      <HintPath>$(WorkshopDir)\2023507013\1.7\Assemblies\PipeSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- VFE Factory ships no 1.7 build: it loads its 1.6 build on 1.7 too. -->
    <Reference Include="VanillaFurnitureExpandedFactory">
      <HintPath>$(WorkshopDir)\3686924415\1.6\Assemblies\VanillaFurnitureExpandedFactory.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.2" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
